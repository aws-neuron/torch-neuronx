#!/usr/bin/env bash
# provision-worktree: create an isolated checkout for a parallel debug agent.
#
# Used by Tier 2 of the dispatch policy. Each parallel agent gets its own
# git worktree + its own venv copy + a rewritten editable-install MAPPING,
# so that source edits in one agent don't collide with another agent's edits
# and so that `import torch_neuronx` resolves to the *worktree's* source,
# not the canonical checkout's.
#
# Usage:
#   .kiro/skills/agent-isolation/scripts/provision-worktree SLUG [BASE_REF]
#
# Arguments:
#   SLUG       — short identifier for the worktree (becomes branch + dir
#                 suffix). Same slug the debugger skill uses.
#   BASE_REF   — git ref to branch off (default: origin/main). Use a SHA if
#                 you want all parallel agents to start from the exact same
#                 commit even if origin/main moved between provisioning.
#
# Output (stdout, one per line):
#   WORKTREE=/tmp/worktrees/<slug>
#   BRANCH=fix/<slug>
#   VENV=/tmp/worktrees/<slug>/.venv
#
# The orchestrator captures these and passes WORKTREE as the agent's CWD.
#
# Why this script exists (from the retro): the editable-install file
# `__editable___torch_neuronx_*_finder.py` MAPPING hardcodes the absolute
# path of the checkout where `uv pip install -e .` ran. Plain
# `git worktree add` gives you a separate filesystem tree, but Python's
# meta-path finder still resolves `torch_neuronx` back to the original
# checkout's source — defeating the point. We rewrite the MAPPING to point
# at the worktree.
#
# Steps:
#   1. git worktree add /tmp/worktrees/<slug>      (off BASE_REF)
#   2. cp -a <active venv> /tmp/worktrees/<slug>/.venv  (separate site-packages)
#   3. rewrite MAPPING in __editable___torch_neuronx_*_finder.py
#   4. nuke stale .pyc under the worktree's torch_neuronx/
#   5. set up branch tracking: branch is fix/<slug> in the worktree, BUT
#      the worktree starts tracking BASE_REF, not the new branch. `gh pr
#      create` requires the local branch to track its remote counterpart;
#      we explicitly clear the upstream so `git push -u origin <branch>`
#      will succeed when the agent gets to the push step.
#   6. symlink build artifacts and the in-tree compiled .so that git does
#      not track (build/, CMakeCache.txt, torch_neuronx/_C.so, the
#      torch-mlir _mlir_libs/*.so). A fresh worktree has the tracked python
#      sources but not these, so `import torch_neuronx` fails without them.
#
# Venv source: the script uses the ACTIVE venv ($VIRTUAL_ENV) first, then a
# repo-root .venv. On a host with a shared venv (for example
# /opt/torch-neuronx/.venv), activate it before you run this script.

set -euo pipefail

SLUG="${1:-}"
BASE_REF="${2:-origin/main}"

if [[ -z "$SLUG" ]]; then
    echo "usage: $0 SLUG [BASE_REF]" >&2
    exit 2
fi

# Slug sanity — the same rule the debugger skill uses for the branch name.
if ! [[ "$SLUG" =~ ^[a-z0-9][a-z0-9_-]*$ ]]; then
    echo "error: slug must be lowercase alphanumeric with - or _ (got: $SLUG)" >&2
    exit 2
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
WORKTREE="${AGENT_WORKTREE_ROOT:-/tmp/worktrees}/${SLUG}"
BRANCH="fix/${SLUG}"

# Refuse to clobber an existing worktree at the same path — usually means a
# previous agent crashed mid-provisioning. The orchestrator should run
# `git worktree remove --force` then retry, deliberately.
if [[ -d "$WORKTREE" ]]; then
    echo "error: worktree dir already exists: $WORKTREE" >&2
    echo "       run: git worktree remove --force $WORKTREE" >&2
    exit 1
fi

# Refuse to reuse a branch name (matches debugger Step 5 rule).
if git -C "$REPO_ROOT" show-ref --verify --quiet "refs/heads/$BRANCH"; then
    echo "error: local branch already exists: $BRANCH" >&2
    exit 1
fi
if git -C "$REPO_ROOT" ls-remote --exit-code --heads origin "$BRANCH" >/dev/null 2>&1; then
    echo "error: remote branch already exists: origin/$BRANCH" >&2
    exit 1
fi

git -C "$REPO_ROOT" fetch origin >/dev/null

# 1. Create the worktree on the new branch.
mkdir -p "$(dirname "$WORKTREE")"
git -C "$REPO_ROOT" worktree add -b "$BRANCH" "$WORKTREE" "$BASE_REF" >/dev/null

# 2. Copy the venv. cp -a preserves symlinks, perms, and ownership.
#    A separate venv gives the agent its own site-packages so a lint-fix
#    install in one agent doesn't bleed into another. It also lets us
#    rewrite this worktree's finder MAPPING without touching other agents.
#    Prefer the ACTIVE venv, then a repo-root .venv. This host may use a
#    shared venv (for example /opt/torch-neuronx/.venv), not a repo-root one.
VENV_SRC=""
if [[ -n "${VIRTUAL_ENV:-}" && -d "$VIRTUAL_ENV" ]]; then
    VENV_SRC="$VIRTUAL_ENV"
elif [[ -d "$REPO_ROOT/.venv" ]]; then
    VENV_SRC="$REPO_ROOT/.venv"
fi
if [[ -n "$VENV_SRC" ]]; then
    cp -a "$VENV_SRC" "$WORKTREE/.venv"
else
    echo "warning: no active venv and no $REPO_ROOT/.venv — activate a venv first" >&2
fi

# 3. Rewrite the editable-install MAPPING to point at the worktree.
#    The finder file is auto-generated by `uv pip install -e .` and lives
#    in site-packages. There's exactly one per editable install; we rewrite
#    every absolute path in it that names the original repo root.
FINDER_GLOB="$WORKTREE/.venv/lib/python*/site-packages/__editable___torch_neuronx_*_finder.py"
mapfile -t finders < <(compgen -G "$FINDER_GLOB" || true)

if [[ ${#finders[@]} -eq 0 ]]; then
    echo "warning: no editable-install finder found under $WORKTREE/.venv" >&2
    echo "         skipping MAPPING rewrite — `import torch_neuronx` may resolve to the wrong tree" >&2
else
    for finder in "${finders[@]}"; do
        # Replace any absolute path that starts at the original repo root
        # with the equivalent path under the worktree.
        python3 - "$finder" "$REPO_ROOT" "$WORKTREE" <<'PY'
import re, sys, pathlib
finder, repo_root, worktree = sys.argv[1:4]
text = pathlib.Path(finder).read_text()
# Match 'repo_root' or 'repo_root/...' inside string literals only — not
# in comments or docstrings. Regex is intentionally conservative.
new = text.replace(repo_root, worktree)
if new != text:
    pathlib.Path(finder).write_text(new)
    print(f"rewrote MAPPING in {finder}", file=sys.stderr)
PY
    done
fi

# 4. Nuke stale .pyc. The bytecode cache embeds absolute paths in
#    co_filename; a stale .pyc imported before the source-level rewrite
#    will keep pointing at the original repo root.
find "$WORKTREE" -name __pycache__ -type d -exec rm -rf {} + 2>/dev/null || true
find "$WORKTREE/.venv" -name '*.pyc' -delete 2>/dev/null || true

# 5. Branch tracking. `git worktree add -b NEW BASE` makes NEW track BASE
#    upstream by default — meaning `git pull` would fast-forward from
#    origin/main and `gh pr create` complains that the branch isn't
#    tracking its own remote. Explicitly clear upstream so the agent's
#    eventual `git push -u origin <branch>` sets it correctly.
git -C "$WORKTREE" branch --unset-upstream "$BRANCH" 2>/dev/null || true

# 6. Symlink build artifacts and the in-tree compiled .so. These aren't
#    tracked by git, so a fresh worktree checkout does not have them, but
#    `import torch_neuronx` needs them. The .so live IN the tree
#    (torch_neuronx/_C.so, third_party/torch-mlir/.../_mlir_libs/*.so),
#    not only under build/. The finder MAPPING rewrite in step 3 points
#    imports at the worktree, so the .so must exist at the same relative
#    path there. Symlink every .so the canonical tree has that the worktree
#    lacks (skip .venv, .git, and build to keep the scan fast).
for artifact in build CMakeCache.txt; do
    if [[ -e "$REPO_ROOT/$artifact" && ! -e "$WORKTREE/$artifact" ]]; then
        ln -s "$REPO_ROOT/$artifact" "$WORKTREE/$artifact"
    fi
done

if [[ ! -e "$WORKTREE/build" ]]; then
    echo "warning: no $REPO_ROOT/build to symlink — agent will need to rebuild C++" >&2
fi

so_linked=0
while IFS= read -r so; do
    rel="${so#"$REPO_ROOT"/}"
    dest="$WORKTREE/$rel"
    if [[ ! -e "$dest" ]]; then
        mkdir -p "$(dirname "$dest")"
        ln -s "$so" "$dest"
        so_linked=$((so_linked + 1))
    fi
done < <(find "$REPO_ROOT" \
    \( -path "$REPO_ROOT/.venv" -o -path "$REPO_ROOT/.git" -o -path "$REPO_ROOT/build" \) -prune \
    -o -name '*.so' -print)

if [[ "$so_linked" -eq 0 ]]; then
    echo "warning: no in-tree .so found to symlink — check the build is complete" >&2
fi

# Output: the orchestrator parses these.
echo "WORKTREE=$WORKTREE"
echo "BRANCH=$BRANCH"
echo "VENV=$WORKTREE/.venv"
