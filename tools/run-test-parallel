#!/bin/bash
# Run tests for torch-neuronx in parallel using multiple neuron devices
# Each test worker will automatically be assigned a unique neuron device

set -e

# Configuration
readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
readonly DEFAULT_IGNORE_DIRS=("tests/tmp" "tests/huggingface" "tests/pytorch_tests" "tests/pytorch_tests_native" "tests/cpu_fallback" "tests/vertical")
readonly SKIP_TESTS=("tests/distributed/" "tests/device/test_multi_device.py" "tests/device/test_device_lnc1_all_cores.py" "tests/operations/test_launch_blocking_invariant.py")
readonly REQUIRED_PACKAGES=("pytest-html" "xdist" "pytest_forked")

# Retry configuration
DEFAULT_NUM_WORKERS_RETRY=4
DEFAULT_RETRY_TIMEOUT=1800

# Global state
declare -g RUNNER=()
declare -g PYTEST_ARGS=""
declare -g NUM_WORKERS=0
declare -g REPORTS_DIR=""
declare -g CUSTOM_NUM_WORKERS=""
declare -g exit_code=0

# Flags
declare -g CUSTOM_N=false
declare -g SKIP_DISTRIBUTED=false
declare -g SKIP_VERTICAL=true
declare -g ENABLE_COVERAGE=false
declare -g ENABLE_JSON_REPORT=false
declare -g HAS_EXPLICIT_TEST_PATH=false
declare -g SKIP_PT_TEST_DISTRIBUTED=false
declare -g SANITY_PT_DISTRIBUTED_TESTS=""
# Share one process per xdist worker instead of forking per test, so the Neuron
# runtime init is paid once per worker. See "Process isolation" in
# docs/AI-testing.md for the full contract.
declare -g NO_FORKED=false
# Per-test timeout, usable only because the shared run drops --forked
# (pytest-timeout and pytest-forked can't be combined).
declare -g NO_FORKED_TEST_TIMEOUT=1800
# Wall-clock ceiling for the shared run, needed because the per-test timeout uses
# the signal method and so cannot interrupt a hang inside a native call. -k
# escalates to SIGKILL: SIGTERM alone leaves a wedged xdist controller waiting on
# its workers, which burned 86 and then 120 min on a 30 min suite.
declare -g NO_FORKED_GROUP_TIMEOUT=3600
# Workers for the isolated pass. Low on purpose: the marked set is the
# device-hostile tests (hard OOMs, a 17GB pre-alloc per parametrization), which
# the full suite only survived because they were spread over an hour.
declare -g NO_FORKED_ISOLATED_WORKERS=4


# Initialize environment
init_environment() {
    cd "$PROJECT_ROOT"
    export NEURON_LAUNCH_BLOCKING="${NEURON_LAUNCH_BLOCKING:-0}"

    if [ -n "$VIRTUAL_ENV" ]; then
        RUNNER=(python)
    elif command -v uv >/dev/null 2>&1; then
        RUNNER=(uv run python)
    else
        RUNNER=(python)
    fi
}

# Check if package is available
check_package() {
    local package="$1"
    "${RUNNER[@]}" -c "import ${package//-/_}" >/dev/null 2>&1
}

# Validate dependencies
validate_dependencies() {
    local missing_packages=()

    for package in "${REQUIRED_PACKAGES[@]}"; do
        if ! check_package "$package"; then
            missing_packages+=("pytest-$package")
        fi
    done

    if [[ "$ENABLE_COVERAGE" == "true" ]] && ! check_package "pytest_cov"; then
        missing_packages+=("pytest-cov")
    fi

    if [[ "$ENABLE_JSON_REPORT" == "true" ]] && ! check_package "pytest_jsonreport"; then
        missing_packages+=("pytest-json-report")
    fi

    if [[ ${#missing_packages[@]} -ne 0 ]]; then
        echo "Error: Missing required packages: ${missing_packages[*]}" >&2
        echo "Please install: pip install ${missing_packages[*]}" >&2
        exit 1
    fi
}

# Get neuron core count
get_neuron_cores() {
    local cores
    cores=$("${RUNNER[@]}" -c "
import json
import subprocess
from torch_neuronx.utils import get_worker_multiplier

result = subprocess.run(['/opt/aws/neuron/bin/neuron-ls', '-j'],
                       capture_output=True, text=True, check=True)
devices = json.loads(result.stdout)
total_cores = sum(device['nc_count'] for device in devices)
multiplier = get_worker_multiplier()
print(total_cores * multiplier)
")

    if [[ ! "$cores" =~ ^[0-9]+$ ]] || [[ "$cores" -eq 0 ]]; then
        echo "Error: Could not detect neuron cores" >&2
        exit 1
    fi

    NUM_WORKERS="$cores"
}

# Parse command line arguments
parse_arguments() {
    local i=0
    local args=("$@")

    while [[ $i -lt ${#args[@]} ]]; do
        local arg="${args[$i]}"
        case "$arg" in
            "-n") CUSTOM_N=true ;;
            "--skip-distributed") SKIP_DISTRIBUTED=true ;;
            "--include-vertical") SKIP_VERTICAL=false ;;
            "--coverage") ENABLE_COVERAGE=true ;;
            "--json-report") ENABLE_JSON_REPORT=true ;;
            "--skip_pt_test_distributed") SKIP_PT_TEST_DISTRIBUTED=true ;;
            "--no-forked") NO_FORKED=true ;;
            "--sanity_pt_distributed_tests")
                SANITY_PT_DISTRIBUTED_TESTS="--sanity_pt_distributed_tests"
                ;;
            "--num_workers")
                i=$((i + 1))
	            [[ $i -lt ${#args[@]} ]] || { echo "Error: --num_workers requires a number argument" >&2; exit 1; }
	            CUSTOM_NUM_WORKERS="${args[$i]}"
                ;;
	            --num_workers=*) CUSTOM_NUM_WORKERS="${arg#--num_workers=}" ;;
            "--report-dir")
                i=$((i + 1))
                [[ $i -lt ${#args[@]} ]] || { echo "Error: --report-dir requires a directory argument" >&2; exit 1; }
                REPORTS_DIR="${args[$i]}"
                ;;
            --report-dir=*) REPORTS_DIR="${arg#--report-dir=}" ;;
            -*) PYTEST_ARGS="$PYTEST_ARGS $arg" ;;
            *) handle_test_path "$arg" ;;
        esac
        i=$((i + 1))
    done
}

# Handle test path normalization
handle_test_path() {
    local arg="$1"
    local norm_path

    if [[ ! "$arg" =~ ^tests/ ]]; then
        norm_path="tests/$arg"
    else
        norm_path="$arg"
    fi

    PYTEST_ARGS="$PYTEST_ARGS $norm_path"

    if [[ ! "$norm_path" =~ ^tests/?$ ]]; then
        HAS_EXPLICIT_TEST_PATH=true
    fi
}

# Build ignore arguments
build_ignore_args() {
    local ignore_args=""

    for dir in "${DEFAULT_IGNORE_DIRS[@]}"; do
        ignore_args+="--ignore=$dir "
    done

    # Always ignore multistream host-cc tests (requires worldsize>8, run separately)
    ignore_args+="--ignore=tests/distributed/collective_ops/test_multistream_collectives_with_host_cc.py "

    # Add multi-device and distributed test ignores for full suite runs
    if [[ "$HAS_EXPLICIT_TEST_PATH" == "false" ]]; then
        for test in "${SKIP_TESTS[@]}"; do
            ignore_args+="--ignore=$test "
        done
    fi

    echo "$ignore_args"
}
# Setup test reports directory and options
setup_reports() {
    if [[ -z "$REPORTS_DIR" ]]; then
        REPORTS_DIR="$PROJECT_ROOT/test-reports"
    fi
    mkdir -p "$REPORTS_DIR"
}

# Build pytest command options
build_pytest_options() {
    local report_name="${1:-report}"
    local workers="${2:-$NUM_WORKERS}"

    local html_opts="--html=$REPORTS_DIR/${report_name}.html --self-contained-html --tb=short"
    local cov_opts=""
    local xdist_args=""
    local json_report_ops=""

    # "isolated-report" is the --forked tail of the same logical group as "report",
    # so it contributes to the same (appended) coverage data.
    if [[ "$ENABLE_COVERAGE" == "true" && ( "$report_name" == "report" || "$report_name" == "isolated-report" ) ]]; then
        local cov_target="torch_neuronx"
        cov_opts="--cov=$cov_target --cov-report=html:$REPORTS_DIR/coverage --cov-report=term-missing --cov-append"
        if [[ "$ENABLE_JSON_REPORT" == "true" ]]; then
            # Add JSON coverage report in addition to HTML
            cov_opts+=" --cov-report=json:$REPORTS_DIR/json_reports/coverage.json"
        fi
    fi

    if [[ "$ENABLE_JSON_REPORT" == "true" ]]; then
        json_report_ops="--json-report --json-report-file=$REPORTS_DIR/json_reports/${report_name}.json"
    fi

    if [[ "$CUSTOM_N" == "false" ]]; then
        xdist_args="-n $workers"
    fi

    local warn_opts="-W 'ignore:This process .* is multi-threaded, use of fork:DeprecationWarning'"

    echo "$xdist_args $html_opts $cov_opts $json_report_ops $warn_opts"
}

# Run command and track exit code, retrying only failed tests on exit code 1.
# allow_empty=true treats exit 5 (nothing collected) as success. Needed by the
# isolated pass: `--no-forked tests/streams` has no marked tests to select, and
# without this the whole run would report failure with every test passing.
run_and_record() {
    local test_name="$1"
    local cmd="$2"
    local allow_empty="${3:-false}"
    echo "Running $test_name: $cmd"
    local test_exit=0
    eval "$cmd" || test_exit=$?

    if [[ $test_exit -eq 5 && "$allow_empty" == "true" ]]; then
        echo "=== $test_name: no tests selected, skipping ==="
        return
    fi

    # Retry only on exit code 1 (test failures with complete cache).
    # Skip timeouts (124/130/137) and internal errors where retry won't help.
    if [[ $test_exit -eq 1 ]]; then
        local num_workers_retry="${NUM_WORKERS_RETRY:-$DEFAULT_NUM_WORKERS_RETRY}"
        local retry_timeout="${RETRY_TIMEOUT:-$DEFAULT_RETRY_TIMEOUT}"
        echo ""
        echo "=== Retrying failed tests for $test_name ($num_workers_retry workers, timeout ${retry_timeout}s) ==="

        # Build retry command: replace worker count and append --last-failed flags.
        # Redirect the retry's HTML/JSON reports to distinct "-retry" filenames —
        # otherwise the retry run (which only collects the previously-failed
        # tests) overwrites the full-suite reports and only the retried tests
        # show up in the uploaded artifacts.
        local retry_cmd
        retry_cmd=$(echo "$cmd" | sed -E "s/-n [0-9]+/-n $num_workers_retry/")
        retry_cmd=$(echo "$retry_cmd" | sed -E \
            -e 's#--html=([^ ]+)\.html#--html=\1-retry.html#' \
            -e 's#--json-report-file=([^ ]+)\.json#--json-report-file=\1-retry.json#')
        retry_cmd="$retry_cmd --last-failed --last-failed-no-failures=none"

        local retry_exit=0
        timeout "$retry_timeout" bash -c "$retry_cmd" || retry_exit=$?

        if [[ $retry_exit -eq 0 || $retry_exit -eq 5 ]]; then
            echo "=== Retry SUCCESS: all previously-failing tests passed on retry ==="
            test_exit=0
        else
            echo "=== Retry incomplete: some tests still failing (retry exit: $retry_exit) ==="
        fi
    fi

    if [[ $test_exit -ne 0 ]]; then
        exit_code=1
    fi
}

run_distributed_test_type() {
    local test_name="$1"
    local report_name="$2"
    local test_file="$3"
    local n="$4"
    local pytest_opts
    pytest_opts=$(build_pytest_options "$report_name" "$n")

    run_and_record "$test_name" "export DISTRIBUTED_TESTS_DEFAULT_TIMEOUT=1200 && ${RUNNER[*]} -m pytest --forked $pytest_opts $SANITY_PT_DISTRIBUTED_TESTS tests/pytorch_tests/distributed/$test_file"
}

# Run main test suite
run_main_tests() {
    local ignore_args
    local pytest_opts
    local test_args="$PYTEST_ARGS"
    local workers="$NUM_WORKERS"

    ignore_args=$(build_ignore_args)

    # Set default test path if none provided
    if [[ ! "$test_args" =~ tests/ ]]; then
        test_args="tests"
    fi

    if [[ -n "$CUSTOM_NUM_WORKERS" && "$HAS_EXPLICIT_TEST_PATH" == "true" ]]; then
	    workers="$CUSTOM_NUM_WORKERS"
	fi
	pytest_opts=$(build_pytest_options "report" "$workers")

    if [[ "$NO_FORKED" != "true" ]]; then
        local cmd="${RUNNER[*]} -m pytest --forked $pytest_opts $test_args $ignore_args"
        run_and_record "main_tests" "$cmd"
        return
    fi

    # --no-forked: share one process per xdist worker, so runtime init is paid once
    # per worker instead of once per test. Tests that cannot share a process carry
    # @pytest.mark.needs_process_isolation and run in the second pass below.
    #
    # Two passes, not a per-test @pytest.mark.forked: forking a worker that has
    # already touched the device is fatal. Why, and when to mark a test:
    # "Process isolation" in docs/AI-testing.md.
    local cmd="timeout -k 120 $NO_FORKED_GROUP_TIMEOUT ${RUNNER[*]} -m pytest --timeout=$NO_FORKED_TEST_TIMEOUT $pytest_opts"
    cmd="$cmd -m 'not needs_process_isolation' $test_args $ignore_args"
    run_and_record "main_tests" "$cmd"

    local isolated_opts
    isolated_opts=$(build_pytest_options "isolated-report" "$NO_FORKED_ISOLATED_WORKERS")
    local isolated_cmd="${RUNNER[*]} -m pytest --forked $isolated_opts"
    isolated_cmd="$isolated_cmd -m needs_process_isolation $test_args $ignore_args"
    run_and_record "isolated_tests" "$isolated_cmd" "true"
}

# Run additional tests
run_additional_tests() {
    if [[ "$HAS_EXPLICIT_TEST_PATH" == "true" ]]; then
        return
    fi

    if [[ "$SKIP_DISTRIBUTED" == "false" ]]; then
        local distributed_workers=$((NUM_WORKERS / 8))
        [[ $distributed_workers -lt 1 ]] && distributed_workers=1

        local pytest_opts
        pytest_opts=$(build_pytest_options "distributed-report" "$distributed_workers")
        run_and_record "distributed_tests" "${RUNNER[*]} -m pytest --forked $pytest_opts tests/distributed --ignore=tests/distributed/collective_ops/test_multistream_collectives_with_host_cc.py --ignore=tests/distributed/collective_ops/test_launch_blocking_collective_invariant.py"

        # Launch blocking collective invariant test (requires CPP_DISPATCH=0)
        local pytest_opts
        pytest_opts=$(build_pytest_options "launch-blocking-collective-invariant-report" "1")
        run_and_record "launch_blocking_collective_invariant" "TORCH_NEURONX_CPP_DISPATCH=0 NEURON_LAUNCH_BLOCKING=1 ${RUNNER[*]} -m pytest --forked $pytest_opts tests/distributed/collective_ops/test_launch_blocking_collective_invariant.py"
    fi

    local pytest_opts
    pytest_opts=$(build_pytest_options "multi-device-report" "1")
    run_and_record "multi_device_tests" "${RUNNER[*]} -m pytest --forked $pytest_opts tests/device/test_multi_device.py"

    # LNC=1 + all cores test (requires special env vars, runs with all cores visible)
    local pytest_opts
    pytest_opts=$(build_pytest_options "lnc1-all-cores-report" "1")
    run_and_record "lnc1_all_cores_tests" "NEURON_LOGICAL_NC_CONFIG=1 ${RUNNER[*]} -m pytest --forked $pytest_opts tests/device/test_device_lnc1_all_cores.py"

    # Launch blocking invariant test (requires CPP_DISPATCH=0 to exercise Python kernel path)
    local pytest_opts
    pytest_opts=$(build_pytest_options "launch-blocking-invariant-report" "1")
    run_and_record "launch_blocking_invariant" "TORCH_NEURONX_CPP_DISPATCH=0 NEURON_LAUNCH_BLOCKING=1 ${RUNNER[*]} -m pytest --forked $pytest_opts tests/operations/test_launch_blocking_invariant.py"

    local pytest_opts
    pytest_opts=$(build_pytest_options "cpu-fallback-report" "$NUM_WORKERS")
    run_and_record "cpu_fallback_tests" "TORCH_NEURONX_FALLBACK_ONLY_FOR_UNIMPLEMENTED_OPS=0 ${RUNNER[*]} -m pytest --forked $pytest_opts tests/cpu_fallback/test_cpu_fallback.py"

    local pytest_opts
    local saved_custom_n="$CUSTOM_N"
    CUSTOM_N=true
    pytest_opts=$(build_pytest_options "host-cc-multi-stream")
    CUSTOM_N="$saved_custom_n"
    run_and_record "$test_name" "export DISTRIBUTED_TESTS_DEFAULT_TIMEOUT=1200 && TORCH_NEURONX_ENABLE_HOST_CC=1 ${RUNNER[*]} -m pytest --forked $pytest_opts tests/distributed/collective_ops/test_multistream_collectives_with_host_cc.py"

    if [[ "$SKIP_VERTICAL" == "false" ]]; then
        local pytest_opts
        pytest_opts=$(build_pytest_options "vertical-report" "$NUM_WORKERS")
        run_and_record "vertical_tests" "${RUNNER[*]} -m pytest --forked $pytest_opts tests/vertical"
    fi

    local pytest_opts
    pytest_opts=$(build_pytest_options "pinned-malloc-report" "1")
    run_and_record "pinned_malloc_tests" "TORCH_NEURONX_USE_PINNED_MALLOC=1 ${RUNNER[*]} -m pytest --forked $pytest_opts tests/operations/test_copy_cpu_to_neuron.py tests/operations/test_copy_neuron_to_cpu.py"

    local pytest_opts
    pytest_opts=$(build_pytest_options "streams-report" "$NUM_WORKERS")
    run_and_record "streams_tests" "${RUNNER[*]} -m pytest --forked $pytest_opts tests/streams"

    # PyTorch tests with fixed worker count
    if [[ "$SKIP_PT_TEST_DISTRIBUTED" != "true" ]]; then
        # Get installed torch version
        local torch_version
        if command -v uv >/dev/null 2>&1; then
            torch_version=$(uv pip list | grep "^torch " | awk '{print $2}' | cut -d'+' -f1)
        else
            torch_version=$(pip list | grep "^torch " | awk '{print $2}' | cut -d'+' -f1)
        fi

        # Fallback if detection fails
        if [[ -z "$torch_version" ]]; then
            torch_version="2.11.0"
            echo "Warning: Could not detect torch version, using fallback: $torch_version"
        else
            echo "Detected torch version: $torch_version"
        fi

        python tests/pytorch_tests/clone_tests.py --torch-version "$torch_version"

        local -a test_files=(
            "test_dtensor.py"
            "test_dtensor_tp.py"
            "test_checkpoint.py"
            "test_common_c10d.py"
            "test_ddp.py"
        )

        test_files+=("test_fsdp.py" "fsdp_v2/")

        # Run each test configuration
        for test_file in "${test_files[@]}"; do
            local test_path="tests/pytorch_tests/distributed/$test_file"

            local base_name="${test_file#test_}"  # Remove "test_" prefix
            base_name="${base_name%.py}"          # Remove ".py" suffix
            base_name="${base_name%/}"            # Remove trailing slash
            local test_name="pytorch_${base_name}_tests"
            local report_name="pytorch-${base_name//_/-}-report"

            local display_name="${base_name^^}"
            display_name="${display_name//_/ }"
            echo "Running PyTorch ${display_name} Tests: $REPORTS_DIR/${report_name}.html"
            run_distributed_test_type "$test_name" "$report_name" "$test_file" "8"
        done
    fi
}

# Display test results summary
display_results() {
    echo ""
    echo "========================================="
    echo "Test Reports Generated:"
    echo "========================================="
    echo "Main Report: $REPORTS_DIR/report.html"

    if [[ "$NO_FORKED" == "true" ]]; then
        echo "Isolated Tests: $REPORTS_DIR/isolated-report.html"
    fi

    if [[ "$ENABLE_COVERAGE" == "true" ]]; then
        echo "Coverage Report: $REPORTS_DIR/coverage/index.html"
    fi

    if [[ "$ENABLE_JSON_REPORT" == "true" ]]; then
        echo "Pytest JSON Report: $REPORTS_DIR/json_reports/report.json"
        echo "Coverage JSON Report: $REPORTS_DIR/json_reports/coverage.json"
    fi

    if [[ "$HAS_EXPLICIT_TEST_PATH" == "false" ]]; then
        if [[ "$SKIP_DISTRIBUTED" == "false" ]]; then
            echo "Distributed Tests: $REPORTS_DIR/distributed-report.html"
        fi
        echo "Multi-Device Tests: $REPORTS_DIR/multi-device-report.html"
        if [[ "$SKIP_VERTICAL" == "false" ]]; then
            echo "Vertical Tests: $REPORTS_DIR/vertical-report.html"
        fi
    fi

    echo "========================================="
}

# Main execution
main() {
    init_environment
    parse_arguments "$@"
    validate_dependencies
    get_neuron_cores
    setup_reports

    echo "Note: Each test worker will be assigned a unique neuron device"
    if [[ "$CUSTOM_N" == "false" ]]; then
        echo "Using $NUM_WORKERS parallel workers"
    fi

    # Clear previous coverage data
    coverage erase

    run_main_tests
    run_additional_tests

    # Generate HUD benchmark NDJSON from JSON reports
    if [[ "$ENABLE_JSON_REPORT" == "true" ]]; then
        echo ""
        echo "=== Generating HUD benchmark results ==="
        PYTHONPATH="$PROJECT_ROOT/tests:${PYTHONPATH:-}" python3 \
            "$PROJECT_ROOT/tests/utils/generate_hud.py" \
            --multi --reports-dir "$REPORTS_DIR" --output-dir "$REPORTS_DIR" \
            || echo "WARNING: HUD generation failed (non-fatal)"
    fi

    display_results

    exit $exit_code
}

main "$@"
