#!/usr/bin/env bash
# with-hw-lock: serialize a hardware-touching command across parallel agents.
#
# Used by Tier 2 of the dispatch policy (parallel debuggers + per-agent
# worktrees + serialized hardware commands). Wrap any command that talks to
# Neuron hardware  -  pytest, ./tools/run-test, tests/pytorch_tests_native/runner/run_upstream_tests.py  -  so
# only one agent runs hardware work at a time even though many agents are
# making progress on non-hardware steps (writing tests, editing source,
# composing PR bodies) in parallel.
#
# The lock is host-wide. Default path is /tmp/agent/hw.lock; override with
# AGENT_HW_LOCK to point at a different location. flock(1) is a Linux util-linux tool;
# every Neuron host has it.
#
# Usage:
#   .external/skills/agent-isolation/scripts/with-hw-lock -- COMMAND...
#
# Examples:
#   # Inside an agent-run wrapped context (Tier 2):
#   with-hw-lock -- pytest tests/python_ops/test_<op>.py
#   with-hw-lock -- ./tools/run-test tests/python_ops/test_<op>.py
#
# Tier 1 (no shared CWD edit conflicts, hardware slices are disjoint) does
# NOT need this wrapper  -  agent-run alone is sufficient. Tier 3 (sequential)
# also doesn't need it  -  there's only one agent at a time.

set -euo pipefail

if [[ "${1:-}" == "--" ]]; then
    shift
fi

if [[ $# -lt 1 ]]; then
    echo "usage: $0 -- COMMAND..." >&2
    exit 2
fi

LOCK_PATH="${AGENT_HW_LOCK:-/tmp/agent/hw.lock}"
mkdir -p "$(dirname "$LOCK_PATH")"

# -x exclusive lock; -w 0 would non-block; we DO want to block  -  that's the
# whole point of the queue. flock(1) holds the lock for the lifetime of the
# subshell, so the command's full run is serialized.
exec flock -x "$LOCK_PATH" "$@"
