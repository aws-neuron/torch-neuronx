# Test suite that includes all cc_test targets in this package.
# New tests added here are automatically included - no need to update //:cpp_unit_tests
test_suite(
    name = "all_tests",
    visibility = ["//visibility:public"],
)

# Test mocks library - shared mock sources for all tests
cc_library(
    name = "test_mocks",
    srcs = glob(["mocks/**/*.cpp"]),
    hdrs = glob(["mocks/**/*.h"]) +
        ["utils/TestUtils.h"],
    copts = [
        "-I.",
        "-Imocks",
        "-isystemexternal/torch",
        "-fvisibility=default",
    ],
    deps = [
        "//:device",
        "//:compilation",
        "//:runtime",
        "//:neuron_bindings",
        "@nrt//:nrt",
        "@torch//:headers",
        "@torch//:runtime_headers",
        "@googletest//:gtest_main",
    ],
    visibility = ["//visibility:public"],
)

