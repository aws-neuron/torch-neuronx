func.func @aten.max_pool2d_with_indices$basic(%arg0: !torch.vtensor<[1,3,32,32],f32>) -> (!torch.vtensor<[],f32>, !torch.vtensor<[1,3,32,32],f32>, !torch.vtensor<[1,3,16,16],si64>) {
    %int2 = torch.constant.int 2
    %int2_0 = torch.constant.int 2
    %0 = torch.prim.ListConstruct %int2, %int2_0 : (!torch.int, !torch.int) -> !torch.list<int>
    %int2_1 = torch.constant.int 2
    %int2_2 = torch.constant.int 2
    %1 = torch.prim.ListConstruct %int2_1, %int2_2 : (!torch.int, !torch.int) -> !torch.list<int>
    %int0 = torch.constant.int 0
    %int0_3 = torch.constant.int 0
    %2 = torch.prim.ListConstruct %int0, %int0_3 : (!torch.int, !torch.int) -> !torch.list<int>
    %int1 = torch.constant.int 1
    %int1_4 = torch.constant.int 1
    %3 = torch.prim.ListConstruct %int1, %int1_4 : (!torch.int, !torch.int) -> !torch.list<int>
    %false = torch.constant.bool false
    %result0, %result1 = torch.aten.max_pool2d_with_indices %arg0, %0, %1, %2, %3, %false : !torch.vtensor<[1,3,32,32],f32>, !torch.list<int>, !torch.list<int>, !torch.list<int>, !torch.list<int>, !torch.bool -> !torch.vtensor<[1,3,16,16],f32>, !torch.vtensor<[1,3,16,16],si64>
    %none = torch.constant.none
    %4 = torch.aten.sum %result0, %none : !torch.vtensor<[1,3,16,16],f32>, !torch.none -> !torch.vtensor<[],f32>
    return %4, %arg0, %result1 : !torch.vtensor<[],f32>, !torch.vtensor<[1,3,32,32],f32>, !torch.vtensor<[1,3,16,16],si64>
}

