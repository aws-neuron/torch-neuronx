load("@llvm-project//llvm:lit_test.bzl", "lit_test")

package(default_visibility = ["//visibility:public"])

[
    lit_test(
        name = "%s.test" % src,
        srcs = [src],
        data = [
            "//third_party/torch-mlir:torch-mlir-opt",
            "//third_party/torch-mlir/test:lit_data",
        ],
    )
    for src in glob(["**/*.mlir"])
]
