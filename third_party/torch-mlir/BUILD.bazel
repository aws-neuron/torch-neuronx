        "@llvm-project//mlir:lib/Bindings/Python/Rewrite.cpp",
    ],
    copts = [
        "-DMLIR_PYTHON_PACKAGE_PREFIX=torch_mlir.",
        "-fexceptions",
        "-frtti",
    ],
    features = ["-use_header_modules"],
    includes = ["external/llvm-project/mlir/lib/Bindings/Python"],
    textual_hdrs = ["@llvm-project//mlir:MLIRBindingsPythonCoreHeaders"],
    deps = [
        "@llvm-project//mlir:CAPIAsync",
