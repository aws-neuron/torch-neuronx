# Dockerfile.pull — PR builds for private-torch-neuronx
# Builds torch-neuronx from PR code on top of a pre-built nightly base image.

ARG BASE_IMAGE_URI=048894428923.dkr.ecr.us-west-2.amazonaws.com/neuron-image-builder-private:private-torch-neuronx-nightly-nightly-base-stable
FROM ${BASE_IMAGE_URI}

ARG REPO_NAME=""

# Copy PR code from build context (cloned by CodeBuild buildspec pre_build)
WORKDIR /workspace
COPY ${REPO_NAME}/ /opt/torch-neuronx-pr/

# Build torch-neuronx from PR code
WORKDIR /opt/torch-neuronx-pr

RUN chmod +x ./tools/*

# Activate venv from nightly-base (has torch-mlir, neuronx_cc, nki, etc.)
ENV UV_PROJECT_ENVIRONMENT=/opt/torch-neuronx/.venv
ENV PATH="/opt/torch-neuronx/.venv/bin:/opt/aws/neuron/bin:$PATH"
ENV NRT_LOCAL_PATH="/opt/aws/neuron"
ENV BAZELISK_BASE_URL=https://github.com/bazelbuild/bazel/releases/download
ENV TORCH_DEVICE_BACKEND_AUTOLOAD=0

# Install and compile (~10-15 min)
RUN uv pip install -e .[dev] && \
    ./tools/build

# Verify
RUN python3 -c "import torch; print(f'PyTorch: {torch.__version__}')" && \
    ls -la /opt/torch-neuronx-pr/torch_neuronx/_C*.so && \
    pip list | grep -i neuron

CMD ["/bin/bash"]
