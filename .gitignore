neuronxcc-*/
log-neuron-cc.txt
global_metric_store.json
file.neff
.torch_neuronx/

# Agent scratch directory — pytorch-upstream-test-debugger skill writes
# per-bug RCA workspaces (notes, baseline/verify reports, PR body drafts,
# verify_failing.sh, completion.json) under agent_artifacts/<slug>/.
# Must never be committed — see
# .kiro/skills/pytorch-upstream-test-debugger/SKILL.md under
# "Artifacts and file I/O".
agent_artifacts/

# Ignore python files generated from proto
torch_neuronx/protos/*.py
torch_neuronx/protos/xla/*.py

# Ignore the pytorch test directory
tests/pytorch_tests/test/
tests/pytorch_tests_native/torch/
tests/pytorch_tests_native/test/

# lock files
MODULE.bazel.lock
uv.lock
.clangd
build

# Claude Code local config — the .claude/skills and .claude/agents
# symlinks are intentionally tracked, but per-user settings are not.
.claude/settings.json
.claude/settings.local.json
